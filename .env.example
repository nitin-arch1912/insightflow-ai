# ============================================================
# InsightFlow AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================

# Application
APP_ENV=development           # development | staging | production
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR

# Server
HOST=0.0.0.0
PORT=8000

# Database (Phase 3 — leave blank for now)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/insightflow

# AI Provider (Phase 7 — leave blank for now)
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Security (Phase 11 — leave blank for now)
# SECRET_KEY=change-me-in-production
# ACCESS_TOKEN_EXPIRE_MINUTES=60
